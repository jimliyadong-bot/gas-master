<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.gas.mapper.GasBuyerMapper">

	<resultMap type="GasBuyer" id="GasBuyerResult">
		<id     property="buyerId"            column="buyer_id"             />
		<result property="buyerName"          column="buyer_name"           />
		<result property="shortName"          column="short_name"           />
		<result property="contactName"        column="contact_name"         />
		<result property="contactPhone"       column="contact_phone"        />
		<result property="notifyPhones"       column="notify_phones"        />
		<result property="invoiceRemindRatio" column="invoice_remind_ratio" />
		<result property="invoiceRemindDays"  column="invoice_remind_days"  />
		<result property="invoiceRemindMax"   column="invoice_remind_max"   />
		<result property="status"             column="status"               />
		<result property="delFlag"            column="del_flag"             />
		<result property="createBy"           column="create_by"            />
		<result property="createTime"         column="create_time"          />
		<result property="updateBy"           column="update_by"            />
		<result property="updateTime"         column="update_time"          />
		<result property="remark"             column="remark"               />
	</resultMap>

	<sql id="selectBuyerVo">
        select buyer_id, buyer_name, short_name, contact_name, contact_phone, notify_phones,
               invoice_remind_ratio, invoice_remind_days, invoice_remind_max, status, del_flag,
               create_by, create_time, update_by, update_time, remark
        from gas_buyer
    </sql>

	<select id="selectBuyerList" parameterType="GasBuyer" resultMap="GasBuyerResult">
		<include refid="selectBuyerVo"/>
		<where>
			del_flag = '0'
			<if test="buyerName != null and buyerName != ''">
				AND buyer_name like concat('%', #{buyerName}, '%')
			</if>
			<if test="contactName != null and contactName != ''">
				AND contact_name like concat('%', #{contactName}, '%')
			</if>
			<if test="contactPhone != null and contactPhone != ''">
				AND contact_phone like concat('%', #{contactPhone}, '%')
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
		</where>
		order by buyer_id
	</select>

	<select id="selectBuyerById" parameterType="Long" resultMap="GasBuyerResult">
		<include refid="selectBuyerVo"/>
		where buyer_id = #{buyerId} and del_flag = '0'
	</select>

	<select id="checkBuyerNameUnique" parameterType="String" resultMap="GasBuyerResult">
		<include refid="selectBuyerVo"/>
		where buyer_name = #{buyerName} and del_flag = '0' limit 1
	</select>

	<insert id="insertBuyer" parameterType="GasBuyer" useGeneratedKeys="true" keyProperty="buyerId">
		insert into gas_buyer(
			<if test="buyerName != null and buyerName != ''">buyer_name,</if>
			<if test="shortName != null">short_name,</if>
			<if test="contactName != null">contact_name,</if>
			<if test="contactPhone != null">contact_phone,</if>
			<if test="notifyPhones != null">notify_phones,</if>
			<if test="invoiceRemindRatio != null">invoice_remind_ratio,</if>
			<if test="invoiceRemindDays != null">invoice_remind_days,</if>
			<if test="invoiceRemindMax != null">invoice_remind_max,</if>
			<if test="status != null and status != ''">status,</if>
			<if test="remark != null">remark,</if>
			<if test="createBy != null and createBy != ''">create_by,</if>
			create_time
		)values(
			<if test="buyerName != null and buyerName != ''">#{buyerName},</if>
			<if test="shortName != null">#{shortName},</if>
			<if test="contactName != null">#{contactName},</if>
			<if test="contactPhone != null">#{contactPhone},</if>
			<if test="notifyPhones != null">#{notifyPhones},</if>
			<if test="invoiceRemindRatio != null">#{invoiceRemindRatio},</if>
			<if test="invoiceRemindDays != null">#{invoiceRemindDays},</if>
			<if test="invoiceRemindMax != null">#{invoiceRemindMax},</if>
			<if test="status != null and status != ''">#{status},</if>
			<if test="remark != null">#{remark},</if>
			<if test="createBy != null and createBy != ''">#{createBy},</if>
			sysdate()
		)
	</insert>

	<update id="updateBuyer" parameterType="GasBuyer">
		update gas_buyer
		<set>
			<if test="buyerName != null and buyerName != ''">buyer_name = #{buyerName},</if>
			<if test="shortName != null">short_name = #{shortName},</if>
			<if test="contactName != null">contact_name = #{contactName},</if>
			<if test="contactPhone != null">contact_phone = #{contactPhone},</if>
			<if test="notifyPhones != null">notify_phones = #{notifyPhones},</if>
			<if test="invoiceRemindRatio != null">invoice_remind_ratio = #{invoiceRemindRatio},</if>
			<if test="invoiceRemindDays != null">invoice_remind_days = #{invoiceRemindDays},</if>
			<if test="invoiceRemindMax != null">invoice_remind_max = #{invoiceRemindMax},</if>
			<if test="status != null and status != ''">status = #{status},</if>
			<if test="remark != null">remark = #{remark},</if>
			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
			update_time = sysdate()
		</set>
		where buyer_id = #{buyerId}
	</update>

	<update id="deleteBuyerByIds" parameterType="Long">
		update gas_buyer set del_flag = '2' where buyer_id in
		<foreach collection="array" item="buyerId" open="(" separator="," close=")">
			#{buyerId}
		</foreach>
	</update>

</mapper>
